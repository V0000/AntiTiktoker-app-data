    {
      "id": "fractions",
      "title": "Дроби",
      "tasks": [
        {
          "id": "fr_part_001",
          "title": "Часть от числа",
          "question": "Найди {P}/{Q} от числа {M}.",
          "variables": {
            "P": { "type": "integer", "min": 1, "max": 5, "step": 1 },
            "Q": { "type": "integer", "min": 2, "max": 9, "step": 1 },
            "M": { "type": "integer", "min": 9, "max": 90, "step": 1 }
          },
          "constraints": [
            "P < Q",
            "M % Q == 0"
          ],
          "answer": "M / Q * P",
          "answerType": "integer",
          "explanation": "Одна часть: {M} ÷ {Q} = {M / Q}. Берём {P} частей: {M / Q} × {P} = {M / Q * P}.",
          "difficulty": 2
        },
        {
          "id": "fr_kg_001",
          "title": "Часть килограмма",
          "question": "Сколько граммов составляет {P}/{Q} килограмма?",
          "variables": {
            "P": { "type": "integer", "min": 1, "max": 3, "step": 1 },
            "Q": { "type": "integer", "min": 2, "max": 8, "step": 1 }
          },
          "constraints": [
            "P < Q",
            "1000 % Q == 0"
          ],
          "answer": "1000 / Q * P",
          "answerType": "integer",
          "explanation": "1 кг = 1000 г. Одна часть: 1000 ÷ {Q} = {1000 / Q} г. Берём {P}: {1000 / Q * P} г.",
          "difficulty": 2
        },
        {
          "id": "fr_num_001",
          "title": "Число по его части",
          "question": "{P}/{Q} от некоторого числа равны {M / Q * P}. Найди это число.",
          "variables": {
            "P": { "type": "integer", "min": 1, "max": 3, "step": 1 },
            "Q": { "type": "integer", "min": 4, "max": 9, "step": 1 },
            "M": { "type": "integer", "min": 8, "max": 72, "step": 1 }
          },
          "constraints": [
            "P < Q",
            "M % Q == 0"
          ],
          "answer": "M",
          "answerType": "integer",
          "explanation": "Одна часть = {M / Q * P} ÷ {P} = {M / Q}. Всё число = {M / Q} × {Q} = {M}.",
          "difficulty": 3
        }
      ]
    },
    {
      "id": "movement",
      "title": "Задачи на движение",
      "tasks": [
        {
          "id": "mv_path_001",
          "title": "Путь, скорость и время",
          "question": "Велосипедист ехал {T} ч со скоростью {V} км/ч. Какой путь он проехал (в км)?",
          "variables": {
            "T": { "type": "integer", "min": 2, "max": 6, "step": 1 },
            "V": { "type": "integer", "min": 7, "max": 18, "step": 1 }
          },
          "constraints": [],
          "answer": "T * V",
          "answerType": "integer",
          "explanation": "Путь = скорость × время = {V} × {T} = {T * V} км.",
          "difficulty": 2
        },
        {
          "id": "mv_speed_001",
          "title": "Найди скорость",
          "question": "Поезд проехал {S} км за {T} ч. Найди его скорость (в км/ч).",
          "variables": {
            "S": { "type": "integer", "min": 120, "max": 720, "step": 10 },
            "T": { "type": "integer", "min": 2, "max": 8, "step": 1 }
          },
          "constraints": [
            "S % T == 0"
          ],
          "answer": "S / T",
          "answerType": "integer",
          "explanation": "Скорость = путь ÷ время = {S} ÷ {T} = {S / T} км/ч.",
          "difficulty": 2
        },
        {
          "id": "mv_meet_001",
          "title": "Встречное движение",
          "question": "Два пешехода идут навстречу друг другу. Скорость первого — {P} км/ч, второго — {Q} км/ч. Через сколько часов они встретятся, если расстояние между ними {S} км?",
          "variables": {
            "P": { "type": "integer", "min": 3, "max": 7, "step": 1 },
            "Q": { "type": "integer", "min": 3, "max": 7, "step": 1 },
            "S": { "type": "integer", "min": 12, "max": 56, "step": 2 }
          },
          "constraints": [
            "S % (P + Q) == 0"
          ],
          "answer": "S / (P + Q)",
          "answerType": "integer",
          "explanation": "Скорость сближения: {P} + {Q} = {P + Q} км/ч. Время: {S} ÷ {P + Q} = {S / (P + Q)} ч.",
          "difficulty": 3
        },
        {
          "id": "mv_time_001",
          "title": "Найди время",
          "question": "Лодка двигалась со скоростью {V} км/ч и проплыла {S} км. Сколько часов она была в пути?",
          "variables": {
            "V": { "type": "integer", "min": 4, "max": 12, "step": 1 },
            "S": { "type": "integer", "min": 12, "max": 96, "step": 2 }
          },
          "constraints": [
            "S % V == 0"
          ],
          "answer": "S / V",
          "answerType": "integer",
          "explanation": "Время = путь ÷ скорость = {S} ÷ {V} = {S / V} ч.",
          "difficulty": 2
        }
      ]
    },
