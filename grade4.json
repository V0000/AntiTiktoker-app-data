          },
          "constraints": [],
          "answer": "A / 100",
          "answerType": "integer",
          "explanation": "Убираем два нуля: {A} ÷ 100 = {A / 100}.",
          "difficulty": 1
        },
        {
          "id": "md_tens_001",
          "title": "Сколько десятков и сотен",
          "question": "Сколько всего сотен в числе {A}?",
          "variables": {
            "A": { "type": "integer", "min": 100, "max": 999, "step": 1 }
          },
          "constraints": [],
          "answer": "(A - A % 100) / 100",
          "answerType": "integer",
          "explanation": "Отбрось десятки и единицы: в числе {A} — {(A - A % 100) / 100} сотни.",
          "difficulty": 2
        }
      ]
