          "explanation": "S = {V} × {T} = {V * T} км.",
          "difficulty": 1
        },
        {
          "id": "fm_perimeter_001",
          "title": "Формула периметра",
          "question": "Найди периметр прямоугольника (в см), если a = {A} см и b = {B} см. (P = 2 × (a + b))",
          "variables": {
            "A": { "type": "integer", "min": 3, "max": 40, "step": 1 },
            "B": { "type": "integer", "min": 3, "max": 40, "step": 1 }
          },
          "constraints": [],
