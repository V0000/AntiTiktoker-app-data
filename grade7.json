          "question": "Температура по Цельсию равна {C}°. Найди температуру по Фаренгейту. (F = 1.8 × C + 32)",
          "variables": {
            "C": { "type": "integer", "min": 0, "max": 40, "step": 5 }
          },
          "constraints": [],
          "answer": "1.8 * C + 32",
          "answerType": "integer",
          "explanation": "F = 1.8 × {C} + 32 = {1.8 * C + 32}°F.",
          "difficulty": 2
