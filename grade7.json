  "topics": [
    {
      "id": "powers",
      "title": "Степени",
      "tasks": [
        {
          "id": "pw_calc_001",
          "title": "Возведение в степень",
          "question": "Вычисли: {A}^{B} = ?",
          "variables": {
            "A": { "type": "integer", "min": 2, "max": 12, "step": 1 },
            "B": { "type": "integer", "min": 2, "max": 3, "step": 1 }
          },
          "constraints": [
            "pow(A, B) <= 2500"
          ],
          "answer": "pow(A, B)",
          "answerType": "integer",
          "explanation": "{A}^{B} — перемножаем {A} само на себя {B} раза: {pow(A, B)}.",
          "difficulty": 1
        },
        {
          "id": "pw_props_001",
          "title": "Свойства степеней",
          "question": "Вычисли: {A}^{B} × {A} = ?",
          "variables": {
            "A": { "type": "integer", "min": 2, "max": 6, "step": 1 },
            "B": { "type": "integer", "min": 2, "max": 3, "step": 1 }
          },
          "constraints": [
            "pow(A, B + 1) <= 2500"
          ],
          "answer": "pow(A, B + 1)",
          "answerType": "integer",
          "explanation": "При умножении степеней с одинаковым основанием показатели складываются: {A}^{B} × {A} = {A}^{B + 1} = {pow(A, B + 1)}.",
          "difficulty": 2
        },
        {
          "id": "pw_props_002",
          "title": "Деление степеней",
          "question": "Вычисли: {A}^{B} ÷ {A} = ?",
          "variables": {
            "A": { "type": "integer", "min": 2, "max": 6, "step": 1 },
            "B": { "type": "integer", "min": 2, "max": 4, "step": 1 }
          },
          "constraints": [],
          "answer": "pow(A, B - 1)",
          "answerType": "integer",
          "explanation": "При делении степеней показатели вычитаются: {A}^{B} ÷ {A} = {A}^{B - 1} = {pow(A, B - 1)}.",
          "difficulty": 2
        },
        {
          "id": "pw_square_sum_001",
          "title": "Квадрат суммы",
          "question": "Вычисли значение выражения {A}² + 2 × {A} × {B} + {B}² при заданных числах.",
          "variables": {
            "A": { "type": "integer", "min": 1, "max": 12, "step": 1 },
            "B": { "type": "integer", "min": 1, "max": 12, "step": 1 }
          },
          "constraints": [],
          "answer": "pow(A + B, 2)",
          "answerType": "integer",
          "explanation": "Это квадрат суммы: ({A} + {B})² = {(A + B)}² = {pow(A + B, 2)}.",
          "difficulty": 3
        }
      ]
    },
    {
      "id": "expressions",
      "title": "Упрощение выражений",
      "tasks": [
        {
          "id": "ex_like_001",
          "title": "Подобные слагаемые",
          "question": "Упрости выражение {A}x + {B} + {C}x. В ответе укажи коэффициент при x.",
          "variables": {
            "A": { "type": "integer", "min": 2, "max": 15, "step": 1 },
            "B": { "type": "integer", "min": 1, "max": 20, "step": 1 },
            "C": { "type": "integer", "min": 2, "max": 15, "step": 1 }
          },
          "constraints": [
            "A + C != 0"
          ],
          "answer": "A + C",
          "answerType": "integer",
          "explanation": "Складываем коэффициенты при x: {A} + {C} = {A + C}. Получается {A + C}x + {B}.",
          "difficulty": 1
        },
        {
          "id": "ex_like_002",
          "title": "Разность подобных слагаемых",
          "question": "Упрости выражение {A}x - {B}x + {C}. В ответе укажи коэффициент при x.",
          "variables": {
            "A": { "type": "integer", "min": 5, "max": 20, "step": 1 },
            "B": { "type": "integer", "min": 1, "max": 4, "step": 1 },
            "C": { "type": "integer", "min": 1, "max": 20, "step": 1 }
          },
          "constraints": [
            "A - B != 0"
          ],
          "answer": "A - B",
          "answerType": "integer",
          "explanation": "Вычитаем коэффициенты: {A} - {B} = {A - B}. Получается {A - B}x + {C}.",
          "difficulty": 1
        },
        {
          "id": "ex_bracket_001",
          "title": "Раскрытие скобок",
          "question": "Упрости выражение {A} × ({B}x + {C}). В ответе укажи коэффициент при x.",
          "variables": {
            "A": { "type": "integer", "min": 2, "max": 9, "step": 1 },
            "B": { "type": "integer", "min": 2, "max": 9, "step": 1 },
            "C": { "type": "integer", "min": 1, "max": 9, "step": 1 }
          },
          "constraints": [],
          "answer": "A * B",
          "answerType": "integer",
          "explanation": "Раскрываем скобки: {A} × {B}x + {A} × {C}. Коэффициент при x равен {A * B}.",
          "difficulty": 2
        },
        {
          "id": "ex_diffsq_001",
          "title": "Разность квадратов",
          "question": "Вычисли: ({A * A} - {B * B}) ÷ ({A} - {B}).",
          "variables": {
            "A": { "type": "integer", "min": 2, "max": 20, "step": 1 },
            "B": { "type": "integer", "min": 1, "max": 19, "step": 1 }
          },
          "constraints": [
            "A != B"
          ],
          "answer": "A + B",
          "answerType": "integer",
          "explanation": "По формуле разности квадратов: {A}² - {B}² = ({A} - {B})({A} + {B}). Делим на ({A} - {B}), остаётся {A} + {B} = {A + B}.",
          "difficulty": 3
        }
      ]
    },
    {
      "id": "linear_equations",
      "title": "Линейные уравнения",
      "tasks": [
        {
          "id": "le_basic_001",
          "title": "Уравнение вида ax + b = c",
          "question": "Реши уравнение: {A}x + {B} = {C}. Найди x.",
          "variables": {
            "A": { "type": "integer", "min": 2, "max": 9, "step": 1 },
            "B": { "type": "integer", "min": 1, "max": 15, "step": 1 },
            "C": { "type": "integer", "min": 12, "max": 90, "step": 1 }
          },
          "constraints": [
            "(C - B) % A == 0"
          ],
          "answer": "(C - B) / A",
          "answerType": "integer",
          "explanation": "{A}x = {C} - {B} = {C - B}. x = {C - B} ÷ {A} = {(C - B) / A}.",
          "difficulty": 2
        },
        {
          "id": "le_basic_002",
          "title": "Уравнение вида ax - b = c",
          "question": "Реши уравнение: {A}x - {B} = {C}. Найди x.",
          "variables": {
            "A": { "type": "integer", "min": 2, "max": 9, "step": 1 },
            "B": { "type": "integer", "min": 1, "max": 15, "step": 1 },
            "C": { "type": "integer", "min": 2, "max": 60, "step": 1 }
          },
          "constraints": [
            "(C + B) % A == 0"
          ],
          "answer": "(C + B) / A",
          "answerType": "integer",
          "explanation": "{A}x = {C} + {B} = {C + B}. x = {C + B} ÷ {A} = {(C + B) / A}.",
          "difficulty": 2
        },
        {
          "id": "le_div_001",
          "title": "Уравнение с делением",
          "question": "Реши уравнение: x ÷ {A} = {B}. Найди x.",
          "variables": {
            "A": { "type": "integer", "min": 2, "max": 9, "step": 1 },
            "B": { "type": "integer", "min": 2, "max": 15, "step": 1 }
          },
          "constraints": [],
          "answer": "A * B",
          "answerType": "integer",
          "explanation": "x = {B} × {A} = {A * B}.",
          "difficulty": 1
        },
        {
          "id": "le_neg_001",
          "title": "Уравнение с отрицательным корнем",
          "question": "Реши уравнение: {A}x + {B} = {C}. Найди x.",
          "variables": {
            "A": { "type": "integer", "min": 2, "max": 9, "step": 1 },
            "B": { "type": "integer", "min": 20, "max": 60, "step": 1 },
            "C": { "type": "integer", "min": 2, "max": 12, "step": 1 }
          },
          "constraints": [
            "(C - B) % A == 0",
            "C < B"
          ],
          "answer": "(C - B) / A",
          "answerType": "integer",
          "explanation": "{A}x = {C} - {B} = {C - B}. x = {C - B} ÷ {A} = {(C - B) / A}.",
          "difficulty": 3
        },
        {
          "id": "le_func_001",
          "title": "Значение функции",
          "question": "Линейная функция задана формулой y = {A}x + ({B}). Найди y, если x = {X}.",
          "variables": {
            "A": { "type": "integer", "min": -5, "max": 5, "step": 1 },
            "B": { "type": "integer", "min": -9, "max": 9, "step": 1 },
            "X": { "type": "integer", "min": -6, "max": 6, "step": 1 }
          },
          "constraints": [
            "A != 0"
          ],
          "answer": "A * X + B",
          "answerType": "integer",
          "explanation": "Подставляем: y = {A} × ({X}) + ({B}) = {A * X + B}.",
          "difficulty": 2
        }
      ]
    },
