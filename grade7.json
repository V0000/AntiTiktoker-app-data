          "title": "Формула стоимости",
          "question": "Найди стоимость покупки C (в руб.), если цена a = {P} руб. и количество n = {N}. (C = a × n)",
          "variables": {
            "P": { "type": "integer", "min": 20, "max": 250, "step": 5 },
            "N": { "type": "integer", "min": 3, "max": 15, "step": 1 }
