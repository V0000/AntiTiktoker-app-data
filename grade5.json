        {
          "id": "pw_square_001",
          "title": "Квадрат числа",
          "question": "Вычисли: {A}² = ?",
          "variables": {
            "A": { "type": "integer", "min": 2, "max": 20, "step": 1 }
          },
          "constraints": [],
          "answer": "A * A",
          "answerType": "integer",
          "explanation": "{A}² = {A} × {A} = {A * A}.",
          "difficulty": 1
        },
        {
          "id": "pw_cube_001",
          "title": "Куб числа",
          "question": "Вычисли: {A}³ = ?",
          "variables": {
            "A": { "type": "integer", "min": 2, "max": 6, "step": 1 }
          },
          "constraints": [],
          "answer": "pow(A, 3)",
          "answerType": "integer",
          "explanation": "{A}³ = {A} × {A} × {A} = {pow(A, 3)}.",
          "difficulty": 2
        },
        {
          "id": "pw_two_001",
          "title": "Степени двойки",
          "question": "Вычисли: 2^{N} = ?",
          "variables": {
            "N": { "type": "integer", "min": 1, "max": 10, "step": 1 }
          },
          "constraints": [],
          "answer": "pow(2, N)",
          "answerType": "integer",
          "explanation": "2^{N} — перемножаем 2 само на себя {N} раз: {pow(2, N)}.",
          "difficulty": 2
        },
        {
          "id": "pw_ten_001",
          "title": "Степени десятки",
          "question": "Вычисли: 10^{N} = ?",
          "variables": {
            "N": { "type": "integer", "min": 1, "max": 6, "step": 1 }
          },
          "constraints": [],
          "answer": "pow(10, N)",
          "answerType": "integer",
          "explanation": "10^{N} — это единица и {N} нулей: {pow(10, N)}.",
          "difficulty": 1
        }
      ]
    },
    {
      "id": "common_fractions",
      "title": "Обыкновенные дроби",
      "tasks": [
        {
          "id": "cf_reduce_001",
          "title": "Сокращение дроби",
          "question": "Сократи дробь {A}/{B}. В ответе укажи числитель полученной дроби.",
          "variables": {
            "A": { "type": "integer", "min": 2, "max": 30, "step": 1 },
            "B": { "type": "integer", "min": 4, "max": 48, "step": 1 }
          },
          "constraints": [
            "A < B",
            "B % A != 0",
            "gcd(A, B) != 1"
          ],
          "answer": "A / gcd(A, B)",
          "answerType": "integer",
          "explanation": "НОД({A}, {B}) = {gcd(A, B)}. Делим числитель и знаменатель на {gcd(A, B)}: числитель станет {A / gcd(A, B)}.",
          "difficulty": 2
        },
        {
          "id": "cf_add_001",
          "title": "Сложение дробей с общим знаменателем",
          "question": "Вычисли: {A}/{C} + {B}/{C}. В ответе укажи числитель суммы (сокращать не нужно).",
          "variables": {
            "A": { "type": "integer", "min": 1, "max": 7, "step": 1 },
            "B": { "type": "integer", "min": 1, "max": 7, "step": 1 },
            "C": { "type": "integer", "min": 8, "max": 15, "step": 1 }
          },
          "constraints": [
            "A + B < C"
          ],
          "answer": "A + B",
          "answerType": "integer",
          "explanation": "Знаменатель общий, складываем числители: {A} + {B} = {A + B}.",
          "difficulty": 1
        },
        {
          "id": "cf_sub_001",
          "title": "Вычитание дробей с общим знаменателем",
          "question": "Вычисли: {B}/{C} - {A}/{C}. В ответе укажи числитель разности (сокращать не нужно).",
          "variables": {
            "A": { "type": "integer", "min": 1, "max": 5, "step": 1 },
            "B": { "type": "integer", "min": 6, "max": 12, "step": 1 },
            "C": { "type": "integer", "min": 13, "max": 20, "step": 1 }
          },
          "constraints": [
            "B > A"
          ],
          "answer": "B - A",
          "answerType": "integer",
          "explanation": "Знаменатель общий, вычитаем числители: {B} - {A} = {B - A}.",
          "difficulty": 1
        },
        {
          "id": "cf_mixed_001",
          "title": "Смешанное число",
          "question": "Представь неправильную дробь {A}/{B} в виде смешанного числа. В ответе укажи его целую часть.",
          "variables": {
            "A": { "type": "integer", "min": 9, "max": 47, "step": 1 },
            "B": { "type": "integer", "min": 3, "max": 8, "step": 1 }
          },
          "constraints": [
            "A > B",
            "A % B != 0"
          ],
          "answer": "(A - A % B) / B",
          "answerType": "integer",
          "explanation": "Делим с остатком: {A} = {B} × {(A - A % B) / B} + {A % B}. Целая часть равна {(A - A % B) / B}.",
          "difficulty": 2
        }
      ]
    },
    {
      "id": "decimals",
      "title": "Десятичные дроби",
      "tasks": [
        {
          "id": "dc_add_001",
