          "constraints": [],
          "answer": "N + N * P / 100",
          "answerType": "integer",
          "explanation": "Рост цены: {N} × {P} ÷ 100 = {N * P / 100} руб. Новая цена: {N} + {N * P / 100} = {N + N * P / 100} руб.",
          "difficulty": 2
        },
        {
          "id": "pc_sale_001",
          "title": "Скидка",
          "question": "Цена книги была {N} руб. Её снизили на {P}%. Сколько теперь стоит книга (в руб.)?",
          "variables": {
            "N": { "type": "integer", "min": 100, "max": 900, "step": 100 },
            "P": { "type": "integer", "min": 5, "max": 25, "step": 5 }
          },
          "constraints": [],
          "answer": "N - N * P / 100",
          "answerType": "integer",
          "explanation": "Скидка: {N} × {P} ÷ 100 = {N * P / 100} руб. Новая цена: {N} - {N * P / 100} = {N - N * P / 100} руб.",
          "difficulty": 2
        },
        {
          "id": "pc_share_001",
          "title": "Сколько процентов составляет",
          "question": "Сколько процентов составляет число {N * P / 100} от числа {N}?",
          "variables": {
            "N": { "type": "integer", "min": 100, "max": 900, "step": 100 },
            "P": { "type": "integer", "min": 5, "max": 25, "step": 5 }
          },
          "constraints": [],
          "answer": "P",
          "answerType": "integer",
          "explanation": "Часть ÷ целое × 100%: ({N * P / 100} ÷ {N}) × 100 = {P}%.",
          "difficulty": 2
        },
        {
          "id": "pc_of_001",
          "title": "Процент от числа",
          "question": "Найди {P}% от {N}.",
          "variables": {
            "P": { "type": "integer", "min": 5, "max": 30, "step": 5 },
            "N": { "type": "integer", "min": 100, "max": 900, "step": 100 }
          },
          "constraints": [],
          "answer": "N * P / 100",
          "answerType": "integer",
          "explanation": "{N} × {P} ÷ 100 = {N * P / 100}.",
          "difficulty": 1
        }
      ]
    },
