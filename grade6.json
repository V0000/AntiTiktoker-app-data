            "B": { "type": "integer", "min": -20, "max": -1, "step": 1 }
          },
          "constraints": [],
          "answer": "A + B",
          "answerType": "integer",
          "explanation": "Прибавить {B} — значит вычесть {abs(B)}: {A} + ({B}) = {A + B}.",
          "difficulty": 2
        },
        {
          "id": "ng_add_002",
          "title": "Сумма двух отрицательных",
          "question": "Вычисли: ({A}) + ({B}) = ?",
          "variables": {
            "A": { "type": "integer", "min": -30, "max": -1, "step": 1 },
            "B": { "type": "integer", "min": -30, "max": -1, "step": 1 }
          },
          "constraints": [],
          "answer": "A + B",
          "answerType": "integer",
          "explanation": "Складываем модули и ставим минус: {A + B}.",
          "difficulty": 2
        },
        {
          "id": "ng_sub_001",
          "title": "Вычитание отрицательного",
          "question": "Вычисли: {A} - ({B}) = ?",
          "variables": {
