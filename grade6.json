            "B": { "type": "integer", "min": -12, "max": -1, "step": 1 }
          },
          "constraints": [],
          "answer": "A * B",
          "answerType": "integer",
          "explanation": "Минус на минус даёт плюс: ({A}) × ({B}) = {A * B}.",
          "difficulty": 2
        },
        {
          "id": "ng_mul_002",
          "title": "Умножение с разными знаками",
          "question": "Вычисли: ({A}) × {B} = ?",
          "variables": {
            "A": { "type": "integer", "min": -12, "max": -1, "step": 1 },
            "B": { "type": "integer", "min": 2, "max": 12, "step": 1 }
          },
          "constraints": [],
          "answer": "A * B",
          "answerType": "integer",
          "explanation": "Разные знаки — результат отрицательный: ({A}) × {B} = {A * B}.",
          "difficulty": 2
        }
      ]
    },
    {
      "id": "modulus",
      "title": "Модуль числа",
      "tasks": [
        {
          "id": "md_basic_001",
          "title": "Модуль числа",
          "question": "Найди модуль числа: |{A}| = ?",
          "variables": {
            "A": { "type": "integer", "min": -30, "max": 30, "step": 1 }
          },
          "constraints": [
            "A != 0"
          ],
          "answer": "abs(A)",
          "answerType": "integer",
          "explanation": "Модуль — это расстояние до нуля, всегда неотрицательный: |{A}| = {abs(A)}.",
          "difficulty": 1
        },
        {
          "id": "md_sum_001",
          "title": "Сумма модулей",
          "question": "Вычисли: |{A}| + |{B}| = ?",
          "variables": {
            "A": { "type": "integer", "min": -20, "max": 20, "step": 1 },
            "B": { "type": "integer", "min": -20, "max": 20, "step": 1 }
          },
          "constraints": [
            "A != 0",
            "B != 0"
          ],
          "answer": "abs(A) + abs(B)",
          "answerType": "integer",
          "explanation": "Сначала раскрой модули: |{A}| = {abs(A)}, |{B}| = {abs(B)}. Сумма: {abs(A) + abs(B)}.",
          "difficulty": 2
        },
        {
          "id": "md_dist_001",
          "title": "Расстояние между точками",
          "question": "На координатной прямой отмечены точки {A} и {B}. Найди расстояние между ними.",
          "variables": {
            "A": { "type": "integer", "min": -20, "max": -1, "step": 1 },
            "B": { "type": "integer", "min": 1, "max": 20, "step": 1 }
          },
          "constraints": [],
          "answer": "abs(A - B)",
          "answerType": "integer",
          "explanation": "Расстояние = |{A} - {B}| = |{A - B}| = {abs(A - B)}.",
          "difficulty": 2
        }
      ]
    },
    {
      "id": "proportions",
      "title": "Пропорции",
      "tasks": [
        {
          "id": "pr_basic_001",
          "title": "Неизвестный член пропорции",
          "question": "Найди неизвестный член пропорции: {A} : {B} = {C} : x. В ответе запиши x.",
          "variables": {
            "A": { "type": "integer", "min": 2, "max": 20, "step": 1 },
            "B": { "type": "integer", "min": 2, "max": 20, "step": 1 },
            "C": { "type": "integer", "min": 2, "max": 20, "step": 1 }
          },
          "constraints": [
            "A != B",
            "(B * C) % A == 0"
          ],
          "answer": "B * C / A",
          "answerType": "integer",
          "explanation": "Основное свойство пропорции: x = {B} × {C} ÷ {A} = {B * C / A}.",
          "difficulty": 2
        },
        {
          "id": "pr_word_001",
          "title": "Задача на пропорцию",
          "question": "За {N} кг яблок заплатили {M} руб. Сколько стоят {K} кг таких яблок (в руб.)?",
          "variables": {
            "N": { "type": "integer", "min": 2, "max": 6, "step": 1 },
            "M": { "type": "integer", "min": 40, "max": 240, "step": 10 },
            "K": { "type": "integer", "min": 2, "max": 9, "step": 1 }
          },
          "constraints": [
            "(M * K) % N == 0"
          ],
          "answer": "M * K / N",
          "answerType": "integer",
          "explanation": "Цена одного кг: {M} ÷ {N} = {M / N} руб. За {K} кг: {M / N} × {K} = {M * K / N} руб.",
          "difficulty": 2
        },
        {
          "id": "pr_map_001",
          "title": "Масштаб",
          "question": "На карте с масштабом 1 : {S} расстояние между домами равно {C} см. Найди реальное расстояние между домами (в см).",
          "variables": {
            "S": { "type": "integer", "min": 100, "max": 5000, "step": 100 },
            "C": { "type": "integer", "min": 2, "max": 25, "step": 1 }
          },
          "constraints": [],
          "answer": "S * C",
          "answerType": "integer",
          "explanation": "Реальное расстояние = {C} × {S} = {S * C} см.",
          "difficulty": 2
        }
      ]
    },
    {
      "id": "percents",
      "title": "Проценты",
      "tasks": [
        {
          "id": "pc_grow_001",
          "title": "Подорожание",
          "question": "Товар стоил {N} руб., а затем подорожал на {P}%. Какова новая цена товара (в руб.)?",
