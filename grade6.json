            "B": { "type": "integer", "min": 2, "max": 12, "step": 1 }
          },
          "constraints": [
            "A != B"
          ],
          "answer": "lcm(A, B)",
          "answerType": "integer",
          "explanation": "НОК({A}, {B}) = {lcm(A, B)} — наименьшее число, которое делится на оба.",
          "difficulty": 2
