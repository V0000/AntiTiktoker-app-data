        {
          "id": "gl_word_001",
          "title": "Задача на НОД",
          "question": "Какое наибольшее число одинаковых подарков можно собрать из {A} конфет и {B} мандаринов, использовав все сладости?",
          "variables": {
            "A": { "type": "integer", "min": 8, "max": 48, "step": 1 },
            "B": { "type": "integer", "min": 10, "max": 60, "step": 1 }
          },
          "constraints": [
            "A != B",
            "gcd(A, B) != 1"
          ],
          "answer": "gcd(A, B)",
          "answerType": "integer",
          "explanation": "Нужно число, которое делит и {A}, и {B}: НОД({A}, {B}) = {gcd(A, B)}.",
          "difficulty": 3
        }
      ]
