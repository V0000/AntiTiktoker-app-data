          },
          "constraints": [],
          "answer": "A - B",
          "answerType": "integer",
          "explanation": "Минус на минус даёт плюс: {A} - ({B}) = {A} + {abs(B)} = {A - B}.",
          "difficulty": 2
        },
        {
          "id": "ng_mul_001",
          "title": "Умножение отрицательных",
          "question": "Вычисли: ({A}) × ({B}) = ?",
          "variables": {
