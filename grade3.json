    {
      "id": "fractions",
      "title": "Доли",
      "tasks": [
        {
          "id": "frac_half_001",
          "title": "Доля числа",
          "question": "Найди {P}/{Q} от числа {M}.",
          "variables": {
            "P": { "type": "integer", "min": 1, "max": 3, "step": 1 },
            "Q": { "type": "integer", "min": 2, "max": 6, "step": 1 },
            "M": { "type": "integer", "min": 6, "max": 60, "step": 1 }
          },
          "constraints": [
