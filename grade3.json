          ],
          "answer": "M / N",
          "answerType": "integer",
          "explanation": "Делим на {N} равные части: {M} ÷ {N} = {M / N}.",
          "difficulty": 2
        },
        {
          "id": "frac_kg_001",
          "title": "Доля килограмма",
          "question": "Сколько граммов составляет 1/{N} килограмма?",
          "variables": {
            "N": { "type": "integer", "min": 2, "max": 4, "step": 1 }
          },
          "constraints": [],
          "answer": "1000 / N",
          "answerType": "integer",
          "explanation": "1 кг = 1000 г. 1000 ÷ {N} = {1000 / N} г.",
          "difficulty": 2
        }
      ]
    }
  ]
